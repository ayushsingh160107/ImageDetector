# TruthLens AI Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security and Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp
MAX_IMAGE_DIMENSION=4096

# Model Configuration
MODEL_TYPE=vit
# Options: "vit" (Vision Transformer e.g. ViT-B/16 fine-tuned on real vs AI) or "resnet" / "custom"
DECISION_THRESHOLD_AI=0.60
DECISION_THRESHOLD_REAL=0.40
# Predictions between 0.40 and 0.60 are considered "Inconclusive"

# Database Configuration
DATABASE_PATH=data/truthlens.db
ENABLE_HISTORY=true
STORE_RAW_IMAGES_IN_DB=false
